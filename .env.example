# Environment Configuration for Perennial Link Ventures Business Directory Platform

# PostgreSQL Database Connection String (e.g. Supabase, Neon, Railway, or a Hostinger VPS)
DATABASE_URL="postgresql://postgres:your-password@db.example.supabase.co:5432/postgres"

# NextAuth Secret & App URL
NEXTAUTH_SECRET="super-secret-random-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="https://market-plv.com"

# Application Settings
NEXT_PUBLIC_APP_NAME="Perennial Link Ventures"
NEXT_PUBLIC_APP_URL="https://market-plv.com"
NEXT_PUBLIC_CONTACT_PHONE="0594772823"
NEXT_PUBLIC_CONTACT_EMAIL="info@market-plv.com"
NEXT_PUBLIC_CONTACT_LOCATION="Tuba/Weija, Greater Accra, Ghana"

# Email Configuration (Resend SMTP)
# Verify your sending domain in Resend first, then use an address on that domain.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD="re_your_resend_api_key"
EMAIL_FROM_NAME="Perennial Link Directory"
EMAIL_FROM="info@market-plv.com"

# Optional emergency fallback. Generate a Google App Password for this account;
# do not use its normal Google password.
GMAIL_SMTP_USER="infoperenniallinkventures@gmail.com"
GMAIL_SMTP_APP_PASSWORD="your-google-app-password"

# Resend Webhook: copy the signing secret from the webhook details page.
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Upload storage: local disk on Hostinger/VPS
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="5"
SEED_DEFAULT_PASSWORD="set-only-when-running-a-production-seed"
# Optional: set to "true" only when you intentionally want demo business listings.
SEED_SAMPLE_DATA="false"

# Upload storage: required on Vercel. Create a Vercel Blob store and add its token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
