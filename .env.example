# Environment Configuration for Perennial Link Ventures Business Directory Platform

# PostgreSQL Database Connection String (e.g. Supabase, Neon, Railway, or a Hostinger VPS)
DATABASE_URL="postgresql://postgres:your-password@db.example.supabase.co:5432/postgres"

# NextAuth Secret & App URL
NEXTAUTH_SECRET="super-secret-random-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_NAME="Perennial Link Ventures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_PHONE="0545898775"
NEXT_PUBLIC_CONTACT_EMAIL="info@perenniallink.com"
NEXT_PUBLIC_CONTACT_LOCATION="Tuba/Weija, Greater Accra, Ghana"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@perenniallink.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM_NAME="Perennial Link Directory"
EMAIL_FROM="noreply@perenniallink.com"

# Upload storage: local disk on Hostinger/VPS
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="5"
SEED_DEFAULT_PASSWORD="set-only-when-running-a-production-seed"

# Upload storage: required on Vercel. Create a Vercel Blob store and add its token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
